NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never give this key a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
APP_URL=http://localhost:3000
# Public storefront and Mentee commerce rollout. Safe default is off.
FEATURE_DIGITAL_PRODUCTS=false
# Midtrans environment: sandbox or production.
MIDTRANS_ENV=sandbox
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
# Optional direct/session-pooler Postgres connection for migrations/imports:
# SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Google Calendar / Meet OAuth (server only; never prefix these with NEXT_PUBLIC_).
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# 32 random bytes, base64 encoded. Used only to encrypt refresh tokens at rest.
# Example generation: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY
